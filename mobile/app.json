{
  "expo": {
    "name": "AMATORA 2027",
    "slug": "amatora-demo",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F7F6",
    "splash": {
      "backgroundColor": "#1E8449"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.demo.amatora"
    },
    "android": {
      "package": "com.demo.amatora",
      "adaptiveIcon": {
        "backgroundColor": "#1E8449"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "description": "Prototype pédagogique non officiel. Ne représente aucun scrutin réel."
    },
    "plugins": [
      "expo-font",
      "expo-asset"
    ]
  }
}
